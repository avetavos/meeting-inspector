{
  "name": "meeting-inspector",
  "version": "0.4.0",
  "private": true,
  "description": "Offline meeting transcription for macOS",
  "author": "Aveta Vos",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "asr:read": "node spike/asr-accuracy/read.mjs",
    "asr:score": "node --experimental-transform-types spike/asr-accuracy/score.mjs",
    "dist": "npm run build:whisper && electron-vite build && electron-builder",
    "icon": "electron build/icon.mjs",
    "build:whisper": "node build/build-whisper.mjs",
    "fixtures": "node spike/fixtures/make.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "electron": "38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4",
    "typescript": "^5",
    "vite": "^7"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.5",
    "sherpa-onnx-node": "^1.13.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avetavos/meeting-inspector.git"
  }
}
